# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,yml,yaml}]
indent_size = 4

[*.{md,cl}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cl]
indent_size = 2

[*.cpp]
indent_size = 2

[*.h]
indent_size = 2

[*.md]
indent_size = 2

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[pyproject.toml]
indent_size = 4
